Header unset Upgrade

<IfModule mod_headers.c>
    Header add Strict-Transport-Security "max-age=84600; includeSubDomains"
</IfModule>

#RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
#RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

Header always set Content-Security-Policy: upgrade-insecure-requests

#Header unset Upgrade
deny from 82.12.189.62
deny from 202.173.124.35
deny from 174.239.112.112
deny from 54.227.89.230

RewriteEngine on

# Rule to remove trailing slash for specific URLs
RewriteCond %{REQUEST_URI} ^/about/$ [OR]
RewriteCond %{REQUEST_URI} ^/privacy-policy/$ [OR]
RewriteCond %{REQUEST_URI} ^/returns/$ [OR]
RewriteCond %{REQUEST_URI} ^/contact/$
RewriteRule ^(.*)/$ /$1 [R=301,L]

# Existing rules
RewriteCond %{REQUEST_URI} !^/pub/
RewriteCond %{REQUEST_URI} !^/setup/
RewriteCond %{REQUEST_URI} !^/update/
RewriteCond %{REQUEST_URI} !^/dev/
RewriteRule .* /pub/$0 [L]

DirectoryIndex index.php

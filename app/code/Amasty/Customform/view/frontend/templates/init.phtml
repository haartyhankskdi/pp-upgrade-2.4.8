<script type="text/javascript">
    require([
        'jquery',
        'Amasty_Customform/js/google-map-loader',
        'Amasty_Customform/js/form-render',
        '<?= $escaper->escapeHtml($viewModel->getFormFillerComponent()) ?>',
        'Amasty_Customform/js/am-google-map',
        'Amasty_Customform/js/form-init'
    ], function($, googleMapLoader) {
        function renderForm() {
            var renderedFormContainer = $('#amform-form-<?= (int)$formId ?> .insert-container'),
                renderedForm;

            $('body').addClass('amform-body');
            $(".amform-show-popup").click(function(){
                $("body").addClass("amform-poup-opened");
            });
            $(".-cross").click(function(){
                $("body").removeClass("amform-poup-opened");
            });

            renderedFormContainer.formRender(
                <?= (int)$formId ?>,
                <?= /* @noEscape */ $block->getFormDataJson() ?>,
                <?= (int)$isSurvey ?>,
                function() {
                    renderedForm = $('[data-amcform-js="multi-page"]');

                    if (renderedForm.length) {
                        renderedForm.amFormInit();
                        renderedForm.amFormFill({
                            'formParams': <?=
                                            /** @noEscape */
                                            $viewModel->getFormParamsJson() ?>
                        });
                        renderedForm.trigger('contentUpdated');
                    }

                    $(document).on('amcform-init-multipage', function(e, form) {
                        var $form = form.find('[data-amcform-js="multi-page"]');

                        if ($form.length) {
                            $form.amFormFill({
                                'formParams': <?=
                                                /** @noEscape */
                                                $viewModel->getFormParamsJson() ?>
                            });
                        }
                    });
                }
            );
        }

        <?php if ($viewModel->isUseGoogleMap()) : ?>
            var deferredObject = googleMapLoader('<?= $escaper->escapeHtml($viewModel->getGoogleKey()) ?>');

            deferredObject.always(renderForm);
        <?php else : ?>
            renderForm();
        <?php endif; ?>



         // custom js for disabled button and error message
        jQuery(document).ready(function($){
            var submitBtn = $('.amcform-submit.action.submit.primary');
            $('input.policy').on('change', function() {
                console.log('aaaaaaaa');
            var val = $(this).val();    
            if(val === 'no' || val === 'option-2'){
                submitBtn.prop('disabled', true).css({'opacity':'0.5', 'pointer-events':'none'});
            } else {
                submitBtn.prop('disabled', false).css({'opacity':'1', 'pointer-events':'auto'});
            }
        });
        });
    });

   
</script>


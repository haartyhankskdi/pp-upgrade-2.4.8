        function insertGpSearchFormAfterLastBefore() {
            console.log('-----------------------------------------------------');

            var $blocks = $('.amcform-page-wrap .amform-layout-one');

            // get the block that contains gp_search_before
            var $targetBlock = $('.gp_search_before').closest('.amform-layout-one');

            // get its index
            var index = $blocks.index($targetBlock);

            console.log("Index:", index);

            // add class to that block
            $blocks.eq(index).addClass('DDDDDDDDDD');

            // create new layout
            var $newLayout = $('<div class="amform-layout-one amform-layout-one--gp-search"></div>');
            var $newGroup  = $('<div class="amform-groupv2 gp-search-group"></div>');
            var $gpForm = $('#gp_search_form');
                        if ($gpForm.length) {
                            $newGroup.append($gpForm);
                            $gpForm.show();
                        } else {
                            console.warn('#gp_search_form not found.');
                        }


            $newLayout.append($newGroup);

            // insert after found index
            $blocks.eq(index).before($newLayout);



            console.log("New layout inserted after index:", index);


            console.log('-----------------------------------------------------');

        }


        function fixDatePickerInputs() {
            const inputs = document.querySelectorAll('input.amform-date._has-datepicker');
            document.querySelectorAll('button.ui-datepicker-trigger').forEach(btn => {
                btn.style.display = 'none';
            });
            inputs.forEach(input => {
                input.removeAttribute('readonly');
                input.setAttribute('type', 'date');
            });
            
            return inputs.length; // returns count of modified inputs
        }
            fixDatePickerInputs();
            
        // run after 5 seconds
        setTimeout(insertGpSearchFormAfterLastBefore, 5000);
        setTimeout(fixDatePickerInputs, 5000);


       










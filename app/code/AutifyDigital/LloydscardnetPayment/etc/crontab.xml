<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
	<group id="default">
		<job instance="AutifyDigital\LloydscardnetPayment\Cron\CancelInactiveOrders" method="execute" name="autifydigital_lloyds_cancel_inactive_orders">
            <schedule>*/5 * * * *</schedule>

<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
	<type name="AutifyDigital\LloydscardnetPayment\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="AutifyDigital\LloydscardnetPayment\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">AutifyDigitalLcnet</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">AutifyDigital\LloydscardnetPayment\Logger\Handler</item>
            </argument>
        </arguments>
    </type>

    <preference for="AutifyDigital\LloydscardnetPayment\Api\PaymentsRepositoryInterface" type="AutifyDigital\LloydscardnetPayment\Model\PaymentsRepository"/>
	<preference for="AutifyDigital\LloydscardnetPayment\Api\Data\PaymentsInterface" type="AutifyDigital\LloydscardnetPayment\Model\Payments"/>
	<preference for="AutifyDigital\LloydscardnetPayment\Api\Data\PaymentsSearchResultsInterface" type="Magento\Framework\Api\SearchResults"/>
	
	<type name="AutifyDigital\LloydscardnetPayment\Model\ResourceModel\Payments\Grid\Collection">
		<arguments>
			<argument name="mainTable" xsi:type="string">autify_lloydscardnetpayment_payments</argument>
			<argument name="resourceModel" xsi:type="string">AutifyDigital\LloydscardnetPayment\Model\ResourceModel\Payments\Collection</argument>
		</arguments>
	</type>
	<type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
		<arguments>
			<argument name="collections" xsi:type="array">
				<item name="autify_lloydscardnetpayment_payments_listing_data_source" xsi:type="string">AutifyDigital\LloydscardnetPayment\Model\ResourceModel\Payments\Grid\Collection</item>
				<item name="sales_order_grid_data_source" xsi:type="string">AutifyDigital\LloydscardnetPayment\Model\ResourceModel\Order\Grid\Collection</item>
			</argument>
		</arguments>
	</type>

	<preference for="AutifyDigital\LloydscardnetPayment\Api\PaymentTokenRepositoryInterface" type="AutifyDigital\LloydscardnetPayment\Model\PaymentTokenRepository"/>
	<preference for="AutifyDigital\LloydscardnetPayment\Api\Data\PaymentTokenInterface" type="AutifyDigital\LloydscardnetPayment\Model\PaymentToken"/>
	<preference for="AutifyDigital\LloydscardnetPayment\Api\Data\PaymentTokenSearchResultsInterface" type="Magento\Framework\Api\SearchResults"/>
</config>

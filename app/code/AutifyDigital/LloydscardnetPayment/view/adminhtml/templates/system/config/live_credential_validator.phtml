<div id="live-lloydscardnet_credential_validator">
    <div class="live-lloydscardnet-validation-container">
        <?= $block->getButtonHtml() ?>
        <div id="live_lloydscardnet_validation_result"
            style="margin-top: 10px; padding: 10px; border-radius: 4px; display: none;">
            <div id="live_lloydscardnet_status_indicator"
                style="width: 12px; height: 12px; border-radius: 50%; display: inline-block; margin-right: 8px;">
            </div>
            <span id="live_lloydscardnet_status_text"></span>
        </div>
    </div>
</div>

<script>
require([
    'jquery',
    'Magento_Ui/js/modal/alert',
    'mage/translate'
], function ($, alert, $t) {
    'use strict';

    window.validateLiveCredentials = function() {
        var buttonId = '#live_lloydscardnet_credentials';
        var button = $(buttonId);
        var resultDiv = $('#live_lloydscardnet_validation_result');
        var statusText = $('#live_lloydscardnet_status_text');
        var statusIndicator = $('#live_lloydscardnet_status_indicator');
        
        button.prop('disabled', true);
        button.find('span').text($t('Validating...'));
        resultDiv.hide();
        
        var storeId = $('input[id*="autifydigital_basic_live_credential_store_id"]').val();
        var sharedSecret = $('input[id*="autifydigital_basic_live_credential_shared_secret"]').val();
        var apiKey = $('input[id*="autifydigital_basic_live_credential_api_key"]').val();  
        var apiSecret = $('input[id*="autifydigital_basic_live_credential_api_secret"]').val();

        if (storeId.length === 0 || sharedSecret.length === 0 || 
            apiKey.length === 0 || apiSecret.length === 0) {
            button.prop('disabled', false);
            button.find('span').text($t('Validate Credentials'));
            alert({
                title: $t('Configuration Error'),
                content: $t('Please fill in all required credentials for Live mode before validation.')
            });
            return;
        }
        
        $.ajax({
            url: '<?= $escaper->escapeUrl($block->getAjaxUrl()) ?>',
            type: 'POST',
            dataType: 'json',
            showLoader: true,
            data: {
                is_prod: 1,
                scope_store_id: '<?= (int) $block->getConfigScopeStoreId() ?>',
                form_key: FORM_KEY
            },
            success: function(response) {
                resultDiv.show();
                statusText.text(response.message || 'Unknown response');
                console.log(response);
                if (response.status === 'ok') {
                    statusIndicator.css('background-color', 'LightGreen');
                    button.find('span').text('✓');
                } else {
                    statusIndicator.css('background-color', 'OrangeRed');
                    button.find('span').text('✗');
                }
                
                setTimeout(function() {
                    button.prop('disabled', false);
                    button.find('span').text($t('Validate Credentials'));
                }, 3000);
            },
            error: function(xhr, status, error) {
                resultDiv.show();
                statusText.text($t('Validation failed: ') + error);
                statusIndicator.css('background-color', 'OrangeRed');
                button.find('span').text('X');
                
                setTimeout(function() {
                    button.prop('disabled', false);
                    button.find('span').text($t('Validate Credentials'));
                }, 3000);
            }
        });
    };
});
</script>

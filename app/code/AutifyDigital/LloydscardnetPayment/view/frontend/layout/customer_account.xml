<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Add the new tab to the customer account navigation -->
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLinkInterface" name="customer-account-navigation-llyoyds-paymentjs-cards" ifconfig="payment/lcnetpaymentjs/active">
                <arguments>
                    <argument name="path" xsi:type="string">lloyds/paymentjs/cards</argument>
                    <argument name="label" xsi:type="string">Lloyds Cardnet Saved Cards</argument>
                    <argument name="sortOrder" xsi:type="number">100</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>


<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <head>
        <title>Lloyds Cardnet Saved Cards</title>
    </head>
    <body>
        <referenceBlock name="page.main.title"> 
            <action method="setPageTitle"> 
                <argument translate="true" name="title" xsi:type="string">Lloyds Cardnet Saved Cards</argument> 
            </action> 
        </referenceBlock> 
        <referenceContainer name="content">
            <block class="AutifyDigital\LloydscardnetPayment\Block\SavedCards" name="lloyds_saved_cards" template="AutifyDigital_LloydscardnetPayment::saved_cards.phtml" />
        </referenceContainer>
    </body>
</page>

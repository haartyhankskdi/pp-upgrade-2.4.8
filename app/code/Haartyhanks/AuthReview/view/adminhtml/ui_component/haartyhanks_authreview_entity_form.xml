<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">haartyhanks_authreview_entity_form.entity_form_data_source</item>
		</item>
		<item name="label" xsi:type="string" translate="true">General Information</item>
		<item name="template" xsi:type="string">templates/form/collapsible</item>
	</argument>
	<settings>
		<buttons>
			<button name="back" class="Haartyhanks\AuthReview\Block\Adminhtml\Entity\Edit\BackButton"/>
			<button name="delete" class="Haartyhanks\AuthReview\Block\Adminhtml\Entity\Edit\DeleteButton"/>
			<button name="save" class="Haartyhanks\AuthReview\Block\Adminhtml\Entity\Edit\SaveButton"/>
			<button name="save_and_continue" class="Haartyhanks\AuthReview\Block\Adminhtml\Entity\Edit\SaveAndContinueButton"/>
		</buttons>
		<namespace>haartyhanks_authreview_entity_form</namespace>
		<dataScope>data</dataScope>
		<deps>
			<dep>haartyhanks_authreview_entity_form.entity_form_data_source</dep>
		</deps>
	</settings>
	<dataSource name="entity_form_data_source">
		<argument name="data" xsi:type="array">
			<item name="js_config" xsi:type="array">
				<item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
			</item>
		</argument>
		<settings>
			<submitUrl path="*/*/save"/>
		</settings>
		<dataProvider name="entity_form_data_source" class="Haartyhanks\AuthReview\Model\Entity\DataProvider">
			<settings>
				<requestFieldName>entity_id</requestFieldName>
				<primaryFieldName>entity_id</primaryFieldName>
			</settings>
		</dataProvider>
	</dataSource>
	<fieldset name="general">
		<settings>
			<label>General</label>
		</settings>
		<field name="name" formElement="input" sortOrder="10">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Entity</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">name</label>
				<dataScope>name</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="photo" formElement="input" sortOrder="20">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Entity</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">photo</label>
				<dataScope>photo</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="credentials" formElement="input" sortOrder="30">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Entity</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">credentials</label>
				<dataScope>credentials</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="specialist" formElement="input" sortOrder="40">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Entity</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">specialist</label>
				<dataScope>specialist</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="registration_number" formElement="input" sortOrder="50">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Entity</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">registration_number</label>
				<dataScope>registration_number</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="bio">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="label" xsi:type="string"/>
                    <item name="formElement" xsi:type="string">wysiwyg</item>
                    <item name="source" xsi:type="string">post</item>
                    <item name="wysiwyg" xsi:type="boolean">true</item>
                    <item name="dataScope" xsi:type="string">bio</item>
                    <item name="additionalClasses" xsi:type="string">admin__field-wide</item>
                    <item name="sortOrder" xsi:type="number">50</item>
                </item>
            </argument>
        </field>
		<field name="external_link" formElement="textarea" sortOrder="70">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Entity</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">external_link</label>
				<dataScope>external_link</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="articles" formElement="textarea" sortOrder="80">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Entity</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">articles</label>
				<dataScope>articles</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="schema" formElement="textarea" sortOrder="90">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Entity</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">schema</label>
				<dataScope>schema</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="default_review" formElement="input" sortOrder="100">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Entity</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">default_review</label>
				<dataScope>default_review</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="default_author" formElement="input" sortOrder="110">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Entity</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">default_author</label>
				<dataScope>default_author</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field name="status" formElement="input" sortOrder="120">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">Entity</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">status</label>
				<dataScope>status</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
	</fieldset>
</form>

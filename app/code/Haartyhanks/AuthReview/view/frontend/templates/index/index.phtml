<?php
/** @var \Magento\Framework\View\Element\Template $block */

$objectManager = \Magento\Framework\App\ObjectManager::getInstance();

/** @var \Haartyhanks\AuthReview\Model\EntityFactory $entityFactory */
$entityFactory = $objectManager->get(\Haartyhanks\AuthReview\Model\EntityFactory::class);

/** @var \Haartyhanks\AuthReview\Model\ResourceModel\Entity\Collection $collection */
$collection = $entityFactory->create()->getCollection();

// optional filters
// $collection->addFieldToFilter('status', 1);

// load and loop
$data =  $collection->load();

?>




<section class="team-section">
  <h2>Meet our team</h2>

  <div class="team-grid">
    <!-- for loop -->
    <?php if(count($data->getData())) : ?>
    <?php foreach ($data->getData() as $data) : ?>
    <article class="team-card">
      <div class="team-image">
        <img src="<?=$data['photo']  ?>" alt="<?=$data['name']  ?>">
      </div>
      <div class="team-content">
        <h3 class="team-name"><?=$data['name']  ?></h3>
        <p class="team-subtitle"><?=$data['registration_number']  ?></p>
        
      </div>
    </article>
    <?php endforeach ; ?>
    <?php endif ; ?>
  </div>
</section>




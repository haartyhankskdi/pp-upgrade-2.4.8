
<?php
/** @var \Magento\Framework\View\Element\Template $block */

$objectManager = \Magento\Framework\App\ObjectManager::getInstance();

/** @var \Haartyhanks\AuthReview\Model\EntityFactory $entityFactory */
$entityFactory = $objectManager->get(\Haartyhanks\AuthReview\Model\EntityFactory::class);

/** @var \Haartyhanks\AuthReview\Model\Entity $entity */
$entity = $entityFactory->create()->load(1);

/** @var \Magefan\Blog\Model\Post $postModel */
$postModel = $objectManager->get(\Magefan\Blog\Model\Post::class);

/** @var \Magefan\Blog\Model\ResourceModel\Post\Collection $blogCollection */
$blogCollection = $postModel->getCollection()
    ->addFieldToFilter('post_author_id', ['eq' => 2]);
// ->addFieldToFilter('status', 1); // optional extra filter

$blogCollection->load();


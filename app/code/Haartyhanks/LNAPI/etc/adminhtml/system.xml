<?xml version="1.0" ?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
	<system>
		<tab id="haartyhanks" translate="label" sortOrder="999">
			<label>Haartyhanks</label>
		</tab>
		<section id="lexis_nexis_configuration" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
			<label>Lexis Nexis Configuration</label>
			<tab>haartyhanks</tab>
			<resource>Haartyhanks_LNAPI::config_haartyhanks_lnapi</resource>
			<group id="general" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
				<label>General Settings</label>
				<field id="enable" type="select" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Enable</label>
					<comment>Enable Email Sending for Lexis Nexis KYC</comment>
					<source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
				</field>
				<field id="url" type="text" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>URL End Point</label>
					<comment>Lexis Nexis End Point</comment>
				</field>
				<field id="id" type="text" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Id </label>
					<comment>Lexis Nexis Account Id</comment>
				</field>
				<field id="ikey" type="obscure" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>IKey</label>
					<comment>Lexis Nexis Account Secret Key</comment>
					<backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
					<config_path>lexis_nexis_configuration/general/ikey</config_path>
				</field>
				<field id="journey_id" type="text" sortOrder="10" showInWebsite="1" showInStore="1" showInDefault="1" translate="label">
					<label>Journey ID </label>
					<comment>JourneyID For Link Generation</comment>
				</field>
			</group>
		</section>
	</system>
</config>
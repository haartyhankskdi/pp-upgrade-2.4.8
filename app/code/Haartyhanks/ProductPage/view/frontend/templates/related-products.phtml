<script>
    require(['jquery'], function($) {
        $(document).ready(function() {
            var $carousel = $('.carousel-items');
            var totalItems = $('.carousel-item').length;
            var itemsPerSlide = $(window).width() >= 768 ? 3 : 1;
            var index = 0;

            function updateCarousel() {
                var itemWidth = $('.carousel-item').outerWidth(true);
                var moveAmount = index * itemWidth;
                $carousel.css({
                    'transform': 'translateX(-' + moveAmount + 'px)',
                    'transition': 'transform 0.5s ease-in-out'
                });
            }

            $('.next-button').click(function() {
                if (index < totalItems - itemsPerSlide) {
                    index++;
                    updateCarousel();
                }
            });

            $('.prev-button').click(function() {
                if (index > 0) {
                    index--;
                    updateCarousel();
                }
            });

            $(window).resize(function() {
                itemsPerSlide = $(window).width() >= 768 ? 3 : 1;
                index = 0;
                updateCarousel();
            });
        });
    });
</script>


<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:Ui/etc/ui_configuration.xsd">
    <fieldset name="search_engine_optimisation">
        <field name="kdi_ad_type" sortOrder="90" formElement="select">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Page Type</label>
                <visible>true</visible>
                <dataScope>kdi_ad_type</dataScope>
                <notice translate="true">Select the type of page for ad handling</notice>
            </settings>
            <formElements>
                <select>
                    <settings>
                        <options class="Kdi\Adpage\Model\Config\Source\Adtype"/>
                    </settings>
                </select>
            </formElements>
        </field>
    </fieldset>
</form>
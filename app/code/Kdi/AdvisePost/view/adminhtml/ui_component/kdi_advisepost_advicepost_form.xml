		<field name="blog_category_id" formElement="input" sortOrder="40">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">AdvicePost</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Blog Category Id</label>
				<dataScope>blog_category_id</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field> 	

		<field name="consultation_url" formElement="input" sortOrder="60">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">AdvicePost</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">Consultation URL</label>
				<dataScope>consultation_url</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
	</fieldset>
	<fieldset name="content" sortOrder="10">
        <settings>
            <collapsible>true</collapsible>
            <label translate="true">Content</label>
        </settings>

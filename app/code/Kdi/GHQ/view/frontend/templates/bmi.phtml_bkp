 <style>
    /*body { font-family: Arial, sans-serif; padding: 20px; }*/
    .bmi-claculator-sec .unit-group { margin-bottom: 20px; border-bottom: 1px solid #bbd6df;
      padding-bottom: 5px;}
    .bmi-claculator-sec .hidden { display: none; }
    .bmi-claculator-sec label { display: block; margin-top: 10px; }
    .bmi-claculator-sec input[type="number"] { width: 100px; margin-right: 10px; }

    .bmi-claculator-sec .switcher {
      display: flex;
      gap: 20px;
      margin-bottom: 10px;
      margin-top: 10px;
    }

    .bmi-claculator-sec .switcher label {
      cursor: pointer;
      color: blue;
      text-decoration: none;
      display: inline-block;
      text-align: center;
      background: #888;
      font-size: 13px;
      color: #FFE;
      font-family: 'Lato', sans-serif;
      line-height: 27px;
      padding: 0 15px;
      border-radius: 5px;
      letter-spacing: 0;
      width: auto;
    }

    .bmi-claculator-sec input[type="radio"] {
      display: none;
    }

    /*.bmi-claculator-sec input[type="radio"]:checked + label {
      font-size: 13px;
      color: #FFE;
      font-family: 'Lato', sans-serif;
      line-height: 27px;
      text-decoration: none;
      background-color: #53CAF5;
    }*/

    .bmi-claculator-sec .result {
      font-size: 1.2em;
      margin-top: 20px;
      width: 180px;
    }

    .bmi-claculator-sec{
      width: auto;  
      background-color: #F1F7F9;
      padding:35px;
      margin-top: 0;
      margin-bottom: 40px;
    }
    .bmi-claculator-sec input{
      height: 42px;
      border-radius: 0; 
      border: 1px solid #a1c1cc;
    }
    .bmi-claculator-sec h2{
      display: block !important;
      padding: 0;
      margin-top: 0;
      border-bottom: 1px solid #bbd6df;
    padding-bottom: 15px;
    margin-bottom: 30px;
    }


  @media only screen and (max-width: 767px) {
    .bmi-claculator-sec{
      width: 100% !important;
    }
    .bmi-claculator-sec h2{
      width: 100%;
    }
    .bmi-claculator-sec input[type="number"]{
        width: 70px;
        margin-right: 0;
    }
    .bmi-claculator-sec input{
      height: 40px !important;
    }

  }
  </style>
</head>
<body>

<div class="bmi-claculator-sec">
  <h2>BMI Calculator</h2>

  <!-- Height Section -->
  <div class="unit-group">
    
    <div id="height-cm">
      <label>Please provide your height: *
        <input type="number" name="bmi_height_cm" id="heightCm" min="0" />
      </label>
    </div>

    <div id="height-ftin" class="hidden">
      <label>Please provide your height:* 
        <input type="number" name="bmi_height_feet" id="heightFt" min="0" class="amform-radiotwo required-entry" /><span>(feet)</span>
      </label>
      <label>Height: 
        <input type="number" id="heightIn" name="bmi_height_inch" min="0" class="amform-radiotwo required-entry" /><span>(inches)</span>
      </label>
    </div>
    <div class="switcher">
      <input type="radio" id="heightCmRadio" name="heightUnit" value="cm" checked />
      <label for="heightCmRadio">CM</label>

      <input type="radio" id="heightFtInRadio" name="heightUnit" value="ftin" />
      <label for="heightFtInRadio">FT + IN</label>
    </div>

  </div>

  <!-- Weight Section -->
  <div class="unit-group">
    
    <div id="weight-kg">
      <label><label>Please provide your Weight:
        <input type="number" name="bmi_weight_kg" id="weightKg" min="0" /><span>(kg)</span>
      </label>
    </div>

    <div id="weight-stlb" class="hidden">
      <label>Weight:
        <input type="number" name="bmi_weight_st" id="weightSt" min="0" /><span>(stone)</span>
      </label>
      <label>Weight:
        <input type="number" id="weightLb" name="bmi_weight_p" min="0" /><span>(pound)</span>
      </label>
    </div>
    <div class="switcher">
      <input type="radio" id="weightKgRadio" name="weightUnit" value="kg" checked />
      <label for="weightKgRadio">KG</label>

      <input type="radio" id="weightStLbRadio" name="weightUnit" value="stlb" />
      <label for="weightStLbRadio">ST + LB</label>
    </div>

  </div>

  <label> <span style="display:none;">Your BMI Value:</span>
    <input type="text" class="result" id="bmiResult" readonly style="display: none;" />
  </label>
  

  <!-- <div class="result" id="bmiResult"></div> -->

</div>

  <script>
    const heightCm = document.getElementById("heightCm");
    const heightFt = document.getElementById("heightFt");
    const heightIn = document.getElementById("heightIn");

    const weightKg = document.getElementById("weightKg");
    const weightSt = document.getElementById("weightSt");
    const weightLb = document.getElementById("weightLb");

    const heightCmGroup = document.getElementById("height-cm");
    const heightFtInGroup = document.getElementById("height-ftin");
    const weightKgGroup = document.getElementById("weight-kg");
    const weightStLbGroup = document.getElementById("weight-stlb");
    const bmiResult = document.getElementById("bmiResult");

    const heightRadios = document.getElementsByName("heightUnit");
    const weightRadios = document.getElementsByName("weightUnit");

    function getSelectedRadioValue(radios) {
      for (let r of radios) {
        if (r.checked) return r.value;
      }
    }

    function toggleHeightInputs() {
      const unit = getSelectedRadioValue(heightRadios);
      heightCmGroup.classList.toggle("hidden", unit !== "cm");
      heightFtInGroup.classList.toggle("", unit !== "ftin");
      calculateBMI();
    }

    function toggleWeightInputs() {
      const unit = getSelectedRadioValue(weightRadios);
      weightKgGroup.classList.toggle("hidden", unit !== "kg");
      weightStLbGroup.classList.toggle("", unit !== "stlb");
      calculateBMI();
    }

    function calculateBMI() {
      let heightMeters = 0;
      let weightInKg = 0;

      const heightUnit = getSelectedRadioValue(heightRadios);
      const weightUnit = getSelectedRadioValue(weightRadios);

      // Height
      if (heightUnit === "cm") {
        const cm = parseFloat(heightCm.value);
        heightMeters = cm > 0 ? cm / 100 : 0;
      } else {
        const ft = parseFloat(heightFt.value) || 0;
        const inches = parseFloat(heightIn.value) || 0;
        const totalInches = (ft * 12) + inches;
        heightMeters = totalInches * 0.0254;
      }

      // Weight
      if (weightUnit === "kg") {
        weightInKg = parseFloat(weightKg.value);
      } else {
        const st = parseFloat(weightSt.value) || 0;
        const lb = parseFloat(weightLb.value) || 0;
        const totalLb = (st * 14) + lb;
        weightInKg = totalLb * 0.453592;
      }

      if (heightMeters > 0 && weightInKg > 0) {
        const bmi = weightInKg / (heightMeters * heightMeters);
        bmiResult.value = `Your BMI is ${bmi.toFixed(2)}`;
      } else {
        bmiResult.value = '';
      }
    }

    // Attach event listeners
    document.querySelectorAll("input").forEach(el => {
      el.addEventListener("input", calculateBMI);
      el.addEventListener("change", () => {
        toggleHeightInputs();
        toggleWeightInputs();
      });
    });

    // Initial toggle
    toggleHeightInputs();
    toggleWeightInputs();
  </script>
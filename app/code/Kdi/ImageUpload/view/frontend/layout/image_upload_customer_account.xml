<?xml version="1.0" ?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
	<update handle="customer_account"/>
	<body>
		<referenceBlock name="breadcrumbs">
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">Home</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string">Home</item>
                    <item name="label" xsi:type="string">Home</item>
                    <item name="link" xsi:type="string">/</item>
                </argument>
            </action>
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">Dashboard</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string">Dashboard</item>
                    <item name="label" xsi:type="string">Dashboard</item>
                    <item name="link" xsi:type="string">/customer/account</item>
                </argument>
            </action>
            <action method="addCrumb">
                <argument name="crumbName" xsi:type="string">Customer</argument>
                <argument name="crumbInfo" xsi:type="array">
                    <item name="title" xsi:type="string">Customer Image Upload</item>
                    <item name="label" xsi:type="string">Customer Image Upload</item>
                </argument>
            </action>
        </referenceBlock>
		<referenceContainer name="content">
			<block class="Kdi\ImageUpload\Block\Customer\Account" name="customer.image.upload" template="Kdi_ImageUpload::customer/image_upload.phtml"/>
		</referenceContainer>
	</body>
</page>

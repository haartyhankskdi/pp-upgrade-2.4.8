<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="pharmacist" resource="default" engine="innodb" comment="Pharmacist Table">
        <column xsi:type="int" name="entity_id" nullable="false" identity="true" unsigned="true" comment="Entity ID"/>
        <column xsi:type="date" name="date" nullable="false" comment="Date"/>
        <column xsi:type="varchar" name="name" nullable="false" length="255" comment="Pharmacist Name"/>
        <column xsi:type="varchar" name="gphc_no" nullable="false" length="255" comment="GPhC Number"/>
        <column xsi:type="varchar" name="pharmacist_type" nullable="false" length="255" comment="Pharmacist Type"/>
        <column xsi:type="varchar" name="qualification" nullable="false" length="255" comment="Qualification"/>
        <column xsi:type="text" name="description" nullable="true" comment="Description"/>
        <column xsi:type="smallint" name="is_enabled" nullable="false" default="0" comment="Enable/Disable"/>
        <column xsi:type="varchar" name="image" nullable="true" length="255" comment="Pharmacist Image"/>

        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>

        <index referenceId="GPHC_NO_INDEX">
            <column name="gphc_no"/>
        </index>

    </table>
</schema>

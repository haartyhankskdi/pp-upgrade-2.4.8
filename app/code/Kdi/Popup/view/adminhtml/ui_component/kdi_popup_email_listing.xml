<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">kdi_popup_email_listing.kdi_popup_email_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>kdi_popup_email_columns</spinner>
        <deps>
            <dep>kdi_popup_email_listing.kdi_popup_email_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="kdi_popup_email_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">email_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Kdi_Popup::Email</aclResource>
        <dataProvider name="kdi_popup_email_listing_data_source" class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>email_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
        <exportButton class="Magento\Ui\Component\ExportButton" component="Magento_Ui/js/grid/export" displayArea="dataGridActions">
            <settings>
                <options>
                    <option name="cvs" xsi:type="array">
                        <item name="value" xsi:type="string">csv</item>
                        <item name="label" xsi:type="string" translate="true">CSV</item>
                        <item name="url" xsi:type="string">kdi_popup/email/exportcsv</item>
                    </option>
                </options>
            </settings>
        </exportButton>
    </listingToolbar>
    <columns name="kdi_popup_email_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>entity_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="entity_id">
            <settings>
                <filter>text</filter>
                <sorting>asc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="product_id">
            <settings>
                <filter>text</filter>
                <label translate="true">product_id</label>
            </settings>
        </column>
        <column name="email">
            <settings>
                <filter>text</filter>
                <label translate="true">Email Id</label>
            </settings>
        </column>
        <column name="customer_ip">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer IP</label>
            </settings>
        </column>
        <column name="created_at">
            <settings>
                <filter>text</filter>
                <label translate="true">Created At</label>
            </settings>
        </column>
    </columns>
</listing>

<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">

    <body>
        <!-- Add testimonials block after product.info.details -->
        <referenceContainer name="content">
            <block class="Magento\Framework\View\Element\Template"
                   name="kdi.testimonials"
                   template="Kdi_Testimonials::testimonials.phtml"
                   after="-">
                   <arguments> 
      				<argument name="view_model" xsi:type="object">Kdi\Testimonials\ViewModel\View</argument> 
				</arguments> 
            </block>
        </referenceContainer>
    </body>
</page>

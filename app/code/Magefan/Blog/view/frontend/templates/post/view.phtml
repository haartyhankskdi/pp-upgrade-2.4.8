                 <?php
// Get post content
$content = $block->getContent();

// Find all H2 and H3 headings
preg_match_all('/<h2[^>]*>(.*?)<\/h2>|<h3[^>]*>(.*?)<\/h3>/', $content, $matches, PREG_SET_ORDER);

$toc = '';
$sectionCount = 0;
$subSectionCount = 0;

if (!empty($matches)) {
    $toc .= '<div class="blog-toc">';
    $toc .= '<h2>Table of Contents</h2>';

    foreach ($matches as $match) {
        if (!empty($match[1])) { // H2 Found
            $sectionCount++;
            $subSectionCount = 0;
            $heading = trim($match[1]);
            $id = 'section-' . $sectionCount;
            $toc .= '<p>' . $sectionCount . '. <a href="#' . $id . '">' . $heading . '</a></p>';

            // Replace original H2 with H2 having an ID
            $content = str_replace('<h2>' . $heading . '</h2>', '<h2 id="' . $id . '">' . $heading . '</h2>', $content);
        } elseif (!empty($match[2])) { // H3 Found
            $subSectionCount++;
            $heading = trim($match[2]);
            $id = 'section-' . $sectionCount . '-' . $subSectionCount;

            $toc .= '<p style="margin-left: 20px;">' . $sectionCount . '.' . $subSectionCount . '. <a href="#' . $id . '">' . $heading . '</a></p>';

            $content = str_replace('<h3>' . $heading . '</h3>', '<h3 id="' . $id . '">' . $heading . '</h3>', $content);
        }
    }

    $toc .= '</div>';
}

// Insert TOC just before the first <h2> or <h3>
$splitContent = preg_split('/(<h[23][^>]*>)/i', $content, 2, PREG_SPLIT_DELIM_CAPTURE);
if (count($splitContent) === 3) {
    $content = $splitContent[0] . $toc . $splitContent[1] . $splitContent[2];
}
?>

<div class="post-text-hld">

 */
?>
<?php
    $_post = $block->getPost();
    $_postUrl = $_post->getPostUrl();
    $_postName = $block->escapeHtml($_post->getTitle(), null);

    // Custom blog product related slider
    $finalCatIds = [];
    $objectManager = \Magento\Framework\App\ObjectManager::getInstance();
    /** @var \Magento\Catalog\Model\ResourceModel\Product\Collection $productCollection */
    $productCollection = $objectManager->create('Magento\Catalog\Model\ResourceModel\Product\Collection');
    $categoryCollection = $objectManager->get('\Magento\Catalog\Model\ResourceModel\Category\CollectionFactory');
    $categories = $categoryCollection->create();
    $categories->addAttributeToSelect('*');
    $categories->addAttributeToFilter('level', array('eq' => 2));

    foreach ($categories as $category) {

        if ($category->getIsActive()) {            
            $catArr[$category->getName()] = $category->getId();
            $categoryFactory = $objectManager->get('\Magento\Catalog\Model\CategoryFactory');
            $categorya = $categoryFactory->create()->load($category->getId());
            $childrenCategories = $categorya->getChildrenCategories();
        }

        foreach ($childrenCategories as $fas){

            if ($fas->getIsActive()) {              
                $catArr[$fas->getName()] = $fas->getId();
            }
        }
    }    

    $categoryCollection = $objectManager->create('Magento\Catalog\Model\ResourceModel\Category\Collection');
    foreach ($_post->getParentCategories() as $ct) {         
        if(array_key_exists($ct->getTitle(), $catArr)){            
            $finalCatIds[] = $catArr[$ct->getTitle()];
        }
    }     
    
    /** Apply filters here */
    $collection = $productCollection->addAttributeToSelect('*')->addCategoriesFilter(['in' => $finalCatIds])->addAttributeToFilter('type_id', 'configurable')->load();
    $mediaUrl = $objectManager->get('Magento\Store\Model\StoreManagerInterface')->getStore()->getBaseUrl(\Magento\Framework\UrlInterface::URL_TYPE_MEDIA);
    $currencysymbol = $objectManager->get('Magento\Directory\Model\Currency');
?>

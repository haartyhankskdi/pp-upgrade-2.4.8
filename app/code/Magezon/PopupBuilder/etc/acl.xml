<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magezon_Core::extensions" title="Magezon">
                    <resource id="Magezon_PopupBuilder::popupbuilder" title="Popup Builder" sortOrder="10">
                        <resource id="Magezon_PopupBuilder::popup" title="Popup" translate="title" sortOrder="10">
                            <resource id="Magezon_PopupBuilder::popup_save" title="Save Popup" sortOrder="10" />
                            <resource id="Magezon_PopupBuilder::popup_delete" title="Delete Popup" sortOrder="20" />
                        </resource>
                        <resource id="Magezon_PopupBuilder::report" title="Report" translate="title" sortOrder="10"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Magezon_PopupBuilder::settings" title="Popup Builder" translate="title" />
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
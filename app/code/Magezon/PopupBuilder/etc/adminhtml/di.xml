<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <virtualType name="Magezon\PopupBuilder\Ui\DataProvider\Popup\Modifier\Pool" type="Magento\Ui\DataProvider\Modifier\Pool">
        <arguments>
            <argument name="modifiers" xsi:type="array">
                <item name="conditions" xsi:type="array">
                    <item name="class" xsi:type="string">Magezon\PopupBuilder\Ui\DataProvider\Popup\Modifier\Conditions</item>
                    <item name="sortOrder" xsi:type="number">10</item>
                </item>
                <item name="triggers" xsi:type="array">
                    <item name="class" xsi:type="string">Magezon\PopupBuilder\Ui\DataProvider\Popup\Modifier\Triggers</item>
                    <item name="sortOrder" xsi:type="number">20</item>
                </item>
                <item name="advanced_rules" xsi:type="array">
                    <item name="class" xsi:type="string">Magezon\PopupBuilder\Ui\DataProvider\Popup\Modifier\AdvancedRules</item>
                    <item name="sortOrder" xsi:type="number">30</item>
                </item>
                <item name="advanced" xsi:type="array">
                    <item name="class" xsi:type="string">Magezon\PopupBuilder\Ui\DataProvider\Popup\Modifier\Advanced</item>
                    <item name="sortOrder" xsi:type="number">40</item>
                </item>
                <item name="popupStyle" xsi:type="array">
                    <item name="class" xsi:type="string">Magezon\PopupBuilder\Ui\DataProvider\Popup\Modifier\PopupStyle</item>
                    <item name="sortOrder" xsi:type="number">50</item>
                </item>
                <item name="overlayStyle" xsi:type="array">
                    <item name="class" xsi:type="string">Magezon\PopupBuilder\Ui\DataProvider\Popup\Modifier\OverlayStyle</item>
                    <item name="sortOrder" xsi:type="number">60</item>
                </item>
                <item name="closeButton" xsi:type="array">
                    <item name="class" xsi:type="string">Magezon\PopupBuilder\Ui\DataProvider\Popup\Modifier\CloseButton</item>
                    <item name="sortOrder" xsi:type="number">70</item>
                </item>
            </argument>
        </arguments>
    </virtualType>
    <type name="Magezon\PopupBuilder\Ui\DataProvider\Popup\FormDataProvider">
        <arguments>
            <argument name="pool" xsi:type="object">Magezon\PopupBuilder\Ui\DataProvider\Popup\Modifier\Pool</argument>
        </arguments>
    </type>
</config>
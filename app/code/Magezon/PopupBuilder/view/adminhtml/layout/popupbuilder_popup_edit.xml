<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="editor"/>
    <head>
    	<css src="Magezon_Core::css/minicolors/jquery.minicolors.css"/>
        <css src="Magezon_Core::css/animate.css"/>
    </head>
    <body>
        <referenceContainer name="content">
            <uiComponent name="popupbuilder_popup_form"/>
        </referenceContainer>
        <referenceContainer name="js">
            <block class="Magento\Framework\View\Element\Template" template="Magezon_UiBuilder::wysiwyg/js.phtml" name="magezon.wysiwyg.js"/>
        </referenceContainer>
        <referenceContainer name="main.top">
            <block class="Magezon\PopupBuilder\Block\Adminhtml\TopMenu" name="page.title" template="Magezon_Core::menu.phtml"/>
        </referenceContainer>
    </body>
</page>
<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <!-- admin API -->
    <!-- Create Ticket -->
    <route url="/V1/helpdesk/ticket" method="POST">
        <service class="Mirasvit\Helpdesk\Api\Service\TicketApiInterface" method="create"/>
        <resources>
            <resource ref="Mirasvit_Helpdesk::helpdesk_ticket"/>
        </resources>
    </route>

    <!-- Update Ticket -->
    <route url="/V1/helpdesk/ticket/:code" method="PUT">
        <service class="Mirasvit\Helpdesk\Api\Service\TicketApiInterface" method="update"/>
        <resources>
            <resource ref="Mirasvit_Helpdesk::helpdesk_ticket"/>
        </resources>
    </route>

    <!-- Add Message to Ticket -->
    <route url="/V1/helpdesk/ticket/:code/message" method="POST">
        <service class="Mirasvit\Helpdesk\Api\Service\TicketApiInterface" method="addMessage"/>
        <resources>
            <resource ref="Mirasvit_Helpdesk::helpdesk_ticket"/>
        </resources>
    </route>

    <!-- Delete Ticket -->
    <route url="/V1/helpdesk/ticket/:code" method="DELETE">
        <service class="Mirasvit\Helpdesk\Api\Service\TicketApiInterface" method="delete"/>
        <resources>
            <resource ref="Mirasvit_Helpdesk::helpdesk_ticket"/>
        </resources>
    </route>

    <!-- Get Messages for Ticket (paginated) -->
    <route url="/V1/helpdesk/ticket/:code/message" method="GET">
        <service class="Mirasvit\Helpdesk\Api\Service\TicketApiInterface" method="getMessages"/>
        <resources>
            <resource ref="Mirasvit_Helpdesk::helpdesk_ticket"/>
        </resources>
    </route>

    <!-- Get Ticket with Messages -->
    <route url="/V1/helpdesk/ticket/:code" method="GET">
        <service class="Mirasvit\Helpdesk\Api\Service\TicketApiInterface" method="get"/>
        <resources>
            <resource ref="Mirasvit_Helpdesk::helpdesk_ticket"/>
        </resources>
    </route>

    <!-- Save Draft Reply -->
    <route url="/V1/helpdesk/ticket/:code/draft" method="PUT">
        <service class="Mirasvit\Helpdesk\Api\Service\TicketApiInterface" method="saveDraft"/>
        <resources>
            <resource ref="Mirasvit_Helpdesk::helpdesk_ticket"/>
        </resources>
    </route>

    <!-- Get Draft Reply -->
    <route url="/V1/helpdesk/ticket/:code/draft" method="GET">
        <service class="Mirasvit\Helpdesk\Api\Service\TicketApiInterface" method="getDraft"/>
        <resources>
            <resource ref="Mirasvit_Helpdesk::helpdesk_ticket"/>

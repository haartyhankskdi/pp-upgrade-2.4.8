    </route>

    <!-- Delete Draft Reply -->
    <route url="/V1/helpdesk/ticket/:code/draft" method="DELETE">
        <service class="Mirasvit\Helpdesk\Api\Service\TicketApiInterface" method="deleteDraft"/>

<?xml version="1.0" ?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">nilesh_contactdb_contactdb_listing.nilesh_contactdb_contactdb_listing_data_source</item>
		</item>
	</argument>
	<settings>
		<spinner>nilesh_contactdb_contactdb_columns</spinner>
		<deps>
			<dep>nilesh_contactdb_contactdb_listing.nilesh_contactdb_contactdb_listing_data_source</dep>
		</deps>
	</settings>
	<dataSource component="Magento_Ui/js/grid/provider" name="nilesh_contactdb_contactdb_listing_data_source">
		<settings>
			<updateUrl path="mui/index/render"/>
		</settings>
		<aclResource>Nilesh_ContactDB::ContactDB</aclResource>
		<dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="nilesh_contactdb_contactdb_listing_data_source">
			<settings>
				<requestFieldName>id</requestFieldName>
				<primaryFieldName>contactdb_id</primaryFieldName>
			</settings>
		</dataProvider>
	</dataSource>
	<listingToolbar name="listing_top">
		<settings>
			<sticky>true</sticky>
		</settings>
		<bookmark name="bookmarks"/>
		<columnsControls name="columns_controls"/>
		<filters name="listing_filters"/>
		<paging name="listing_paging"/>
	</listingToolbar>
	<columns name="nilesh_contactdb_contactdb_columns">
		<selectionsColumn name="ids">
			<settings>
				<indexField>contactdb_id</indexField>
			</settings>
		</selectionsColumn>
		<column name="contactdb_id">
			<settings>
				<filter>text</filter>
				<sorting>asc</sorting>
				<label translate="true">ID</label>
			</settings>
		</column>
		<column name="name">
			<settings>
				<filter>text</filter>
				<label translate="true">Name</label>
			</settings>
		</column>
		<column name="email">
			<settings>
				<filter>text</filter>
				<label translate="true">Email</label>
			</settings>
		</column>
		<column name="contact">
			<settings>
				<filter>text</filter>
				<label translate="true">Contact</label>
			</settings>
		</column>
		<column name="comment">
			<settings>
				<filter>text</filter>
				<label translate="true">comment</label>
			</settings>
		</column>
		<column name="preference">
			<settings>
				<filter>text</filter>
				<label translate="true">Communication Preference</label>
			</settings>
		</column>
		<column name="created_date">
			<settings>
				<filter>text</filter>
				<label translate="true">Created On</label>
			</settings>
		</column>
	</columns>
</listing>

<?xml version="1.0" ?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
	<table comment="nilesh_gpmanagement_gpmanagement Table" engine="innodb" name="nilesh_gpmanagement_gpmanagement" resource="default">
		<column comment="Entity Id" identity="true" name="gpmanagement_id" nullable="false" padding="6" unsigned="true" xsi:type="smallint"/>
		<constraint referenceId="PRIMARY" xsi:type="primary">
			<column name="gpmanagement_id"/>
		</constraint>
		<column length="255" name="practice_code" nullable="true" xsi:type="varchar"/>
		<column length="255" name="name_of_practice" nullable="true" xsi:type="varchar"/>
		<column length="255" name="email" nullable="true" xsi:type="varchar"/>
		<column length="255" name="telephone" nullable="true" xsi:type="varchar"/>
		<column name="address_line_one" nullable="true" xsi:type="text"/>
		<column name="address_line_two" nullable="true" xsi:type="text"/>
		<column length="255" name="city" nullable="true" xsi:type="varchar"/>
		<column length="255" name="county" nullable="true" xsi:type="varchar"/>
		<column length="255" name="postcode" nullable="true" xsi:type="varchar"/>
		<column name="additional_info" nullable="true" xsi:type="text"/>
		<column default="CURRENT_TIMESTAMP" name="created_date" on_update="false" nullable="true" xsi:type="timestamp"/>
		<column default="CURRENT_TIMESTAMP" name="modify_date" on_update="true" nullable="true" xsi:type="timestamp"/>
	</table>
</schema>

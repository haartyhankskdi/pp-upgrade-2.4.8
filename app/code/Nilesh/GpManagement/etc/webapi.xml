<?xml version="1.0" ?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
	<route method="POST" url="/V1/nilesh-gpmanagement/gpmanagement">
		<service class="Nilesh\GpManagement\Api\GpManagementRepositoryInterface" method="save"/>
		<resources>
			<resource ref="Nilesh_GpManagement::GpManagement_save"/>
		</resources>
	</route>
	<route method="GET" url="/V1/nilesh-gpmanagement/gpmanagement/search">
		<service class="Nilesh\GpManagement\Api\GpManagementRepositoryInterface" method="getList"/>
		<resources>
			<resource ref="Nilesh_GpManagement::GpManagement_view"/>
		</resources>
	</route>
	<route method="GET" url="/V1/nilesh-gpmanagement/gpmanagement/:gpmanagementId">
		<service class="Nilesh\GpManagement\Api\GpManagementRepositoryInterface" method="get"/>
		<resources>
			<resource ref="Nilesh_GpManagement::GpManagement_view"/>
		</resources>
	</route>
	<route method="PUT" url="/V1/nilesh-gpmanagement/gpmanagement/:gpmanagementId">
		<service class="Nilesh\GpManagement\Api\GpManagementRepositoryInterface" method="save"/>
		<resources>
			<resource ref="Nilesh_GpManagement::GpManagement_update"/>
		</resources>
	</route>
	<route method="DELETE" url="/V1/nilesh-gpmanagement/gpmanagement/:gpmanagementId">
		<service class="Nilesh\GpManagement\Api\GpManagementRepositoryInterface" method="deleteById"/>
		<resources>
			<resource ref="Nilesh_GpManagement::GpManagement_delete"/>
		</resources>
	</route>
</routes>

<?xml version="1.0" ?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
	<argument name="data" xsi:type="array">
		<item name="js_config" xsi:type="array">
			<item name="provider" xsi:type="string">nilesh_gpmanagement_gpmanagement_form.gpmanagement_form_data_source</item>
		</item>
		<item name="label" translate="true" xsi:type="string">General Information</item>
		<item name="template" xsi:type="string">templates/form/collapsible</item>
	</argument>
	<settings>
		<buttons>
			<button class="Nilesh\GpManagement\Block\Adminhtml\GpManagement\Edit\BackButton" name="back"/>
			<button class="Nilesh\GpManagement\Block\Adminhtml\GpManagement\Edit\DeleteButton" name="delete"/>
			<button class="Nilesh\GpManagement\Block\Adminhtml\GpManagement\Edit\SaveButton" name="save"/>
			<button class="Nilesh\GpManagement\Block\Adminhtml\GpManagement\Edit\SaveAndContinueButton" name="save_and_continue"/>
		</buttons>
		<namespace>nilesh_gpmanagement_gpmanagement_form</namespace>
		<dataScope>data</dataScope>
		<deps>
			<dep>nilesh_gpmanagement_gpmanagement_form.gpmanagement_form_data_source</dep>
		</deps>
	</settings>
	<dataSource name="gpmanagement_form_data_source">
		<argument name="data" xsi:type="array">
			<item name="js_config" xsi:type="array">
				<item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
			</item>
		</argument>
		<settings>
			<submitUrl path="*/*/save"/>
		</settings>
		<dataProvider class="Nilesh\GpManagement\Model\GpManagement\DataProvider" name="gpmanagement_form_data_source">
			<settings>
				<requestFieldName>gpmanagement_id</requestFieldName>
				<primaryFieldName>gpmanagement_id</primaryFieldName>
			</settings>
		</dataProvider>
	</dataSource>
	<fieldset name="general">
		<settings>
			<label>General</label>
		</settings>
		<field formElement="input" name="practice_code" sortOrder="10">
			<argument name="data" xsi:type="array">
				<item name="config" xsi:type="array">
					<item name="source" xsi:type="string">GpManagement</item>
				</item>
			</argument>
			<settings>
				<dataType>text</dataType>
				<label translate="true">practice_code</label>
				<dataScope>practice_code</dataScope>
				<validation>
					<rule name="required-entry" xsi:type="boolean">false</rule>
				</validation>
			</settings>
		</field>
		<field formElement="input" name="name_of_practice" sortOrder="20">
			<argument name="data" xsi:type="array">

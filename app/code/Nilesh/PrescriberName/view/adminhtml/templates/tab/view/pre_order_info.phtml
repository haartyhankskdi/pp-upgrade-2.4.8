?>

<?php 
$pList = $block->getPrescriberList();
$spname = $this->getPrescriberName();
// print_r($pList);
?>

<div class="fieldset-wrapper order-information">
    <div class="fieldset-wrapper-title">
        <span class="title">
            <?php /* @escapeNotVerified */ echo __('Set Prescriber Name') ?>
        </span>
    </div>
    
    <div class="prescriber_form">
        <input type="hidden" value="<?php echo $block->getOrderId(); ?>" id="order_id">
        <select id="prescriber_name">
            <option value="">Select Name</option>
            <?php 
                foreach ($pList as $row) {
                    ?>
                        <option value="<?php echo $row['prescribername_id']; ?>" <?php if($spname == $row['prescribername_id']){ echo "selected"; } ?> ><?php echo $row['name']; ?></option>
                    <?php
                }
            ?>
        </select>
        <button id="prescriber_button" type="button"><div class="button-spinner" style="display:none"></div>Save</button>
    </div>
</div>
<script>
    require(['jquery'], function($){
        $(document).ready(function () {
            $("#prescriber_button").click(function (e) { 
                e.preventDefault();
                // console.log("Hello");
                $(".button-spinner").show();
                var order_id = $("#order_id").val();
                var prescriber_name = $("#prescriber_name").val();
                if(prescriber_name.length > 0){
                    $.post("<?php echo $this->getUrl('prescriber/ajax/index'); ?>", {
                        order_id : order_id,
                        prescriber_name : prescriber_name
                    },
                    function (data) {
                        // console.log(data);
                        if(data.status){
                            alert(data.message);
                        }else{
                            alert(data.message);
                        }
                        $(".button-spinner").hide();
                    },
                    "json"
                    );
                }else{
                        alert("Please select prescriber name");
                        $(".button-spinner").hide();
                }
            });
        });
    });
</script>

<?php if(empty($spname)): ?>

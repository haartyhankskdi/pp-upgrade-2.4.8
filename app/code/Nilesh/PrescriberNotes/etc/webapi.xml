<?xml version="1.0" ?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
	<route url="/V1/nilesh-prescribernotes/prescribernotes" method="POST">
		<service class="Nilesh\PrescriberNotes\Api\PrescriberNotesRepositoryInterface" method="save"/>
		<resources>
			<resource ref="Nilesh_PrescriberNotes::PrescriberNotes_save"/>
		</resources>
	</route>
	<route url="/V1/nilesh-prescribernotes/prescribernotes/search" method="GET">
		<service class="Nilesh\PrescriberNotes\Api\PrescriberNotesRepositoryInterface" method="getList"/>
		<resources>
			<resource ref="Nilesh_PrescriberNotes::PrescriberNotes_view"/>
		</resources>
	</route>
	<route url="/V1/nilesh-prescribernotes/prescribernotes/:prescribernotesId" method="GET">
		<service class="Nilesh\PrescriberNotes\Api\PrescriberNotesRepositoryInterface" method="get"/>
		<resources>
			<resource ref="Nilesh_PrescriberNotes::PrescriberNotes_view"/>
		</resources>
	</route>
	<route url="/V1/nilesh-prescribernotes/prescribernotes/:prescribernotesId" method="PUT">
		<service class="Nilesh\PrescriberNotes\Api\PrescriberNotesRepositoryInterface" method="save"/>
		<resources>
			<resource ref="Nilesh_PrescriberNotes::PrescriberNotes_update"/>
		</resources>
	</route>
	<route url="/V1/nilesh-prescribernotes/prescribernotes/:prescribernotesId" method="DELETE">
		<service class="Nilesh\PrescriberNotes\Api\PrescriberNotesRepositoryInterface" method="deleteById"/>
		<resources>
			<resource ref="Nilesh_PrescriberNotes::PrescriberNotes_delete"/>
		</resources>
	</route>
</routes>

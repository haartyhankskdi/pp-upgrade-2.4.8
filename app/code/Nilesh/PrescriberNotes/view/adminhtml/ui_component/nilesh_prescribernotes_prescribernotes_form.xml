			<item name="js_config" xsi:type="array">
				<item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
			</item>
		</argument>
		<settings>
			<submitUrl path="*/*/save"/>
		</settings>
		<dataProvider name="prescribernotes_form_data_source" class="Nilesh\PrescriberNotes\Model\PrescriberNotes\DataProvider">
			<settings>
				<requestFieldName>prescribernotes_id</requestFieldName>
				<primaryFieldName>prescribernotes_id</primaryFieldName>
			</settings>

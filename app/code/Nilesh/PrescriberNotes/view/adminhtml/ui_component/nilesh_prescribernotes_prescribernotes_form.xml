		</buttons>
		<namespace>nilesh_prescribernotes_prescribernotes_form</namespace>
		<dataScope>data</dataScope>
		<deps>
			<dep>nilesh_prescribernotes_prescribernotes_form.prescribernotes_form_data_source</dep>
		</deps>
	</settings>
	<dataSource name="prescribernotes_form_data_source">

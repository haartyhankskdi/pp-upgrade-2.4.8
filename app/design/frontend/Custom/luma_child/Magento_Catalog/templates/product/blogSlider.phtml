<?php
/** @var \Magento\Framework\View\Element\Template $block */
$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
$registry = $objectManager->get(\Magento\Framework\Registry::class);
$product = $registry->registry('current_product');

if ($product && $product->getId()) {
    $categoryIds = $product->getCategoryIds();

    if (!empty($categoryIds)) {
        $categoryRepository = $objectManager->get(\Magento\Catalog\Model\CategoryRepository::class);
        $blogCategoryFactory = $objectManager->get(\Magefan\Blog\Model\CategoryFactory::class);
        $blogCategoryModel = $objectManager->get(\Magefan\Blog\Model\Category::class);

        
        // Magento Category ID => Blog Category ID mapping
        $categoryBlogMap = [
            161 => 44, 160 => 43, 107 => 41, 148 => 40, 143 => 39,
            149 => 38, 101 => 37, 98 => 36, 95 => 35, 147 => 34,
            145 => 33, 142 => 32, 141 => 30, 91 => 29, 140 => 28,
            88 => 27, 85 => 26, 84 => 25, 181 => 24, 95 => 22,
            81 => 21, 99 => 20, 121 => 19, 90 => 17, 91 => 16,
            89 => 15, 108 => 14, 162 => 13, 106 => 12, 92 => 11,
            85 => 9, 104 => 8, 83 => 7, 82 => 6, 102 => 4,
            87 => 3, 168 => 2, 96 => 1,
        ];

        $matchedBlogCategoryIds = [];
        $firstBlogCategoryId = null;

        foreach ($categoryBlogMap as $magentoCatId => $blogCatId) {
            if (in_array($magentoCatId, $categoryIds)) {
                $matchedBlogCategoryIds[] = $blogCatId;
                if (!$firstBlogCategoryId) {
                    $firstBlogCategoryId = $blogCatId;
                }
            }
        }

        if (!empty($matchedBlogCategoryIds)) {
            /** @var \Magefan\Blog\Model\PostFactory $postFactory */
            $postFactory = $objectManager->get(\Magefan\Blog\Model\PostFactory::class);
            $collection = $postFactory->create()->getCollection();

            // Join blog post with blog post category relation table
            $collection->getSelect()->join(
                ['rel' => 'magefan_blog_post_category'],
                'main_table.post_id = rel.post_id',
                []
            )->where('rel.category_id IN (?)', $matchedBlogCategoryIds);

            // Filter + order + limit
            $collection->addFieldToFilter('is_active', 1)
                       ->getSelect()
                       ->group('main_table.post_id')
                       ->order('publish_time DESC')
                       ->limit(10);

            // Get blog category URL
            $blogCategoryUrl = '#';
            if ($firstBlogCategoryId) {
                try {
                    $blogCategory = $blogCategoryModel->load($firstBlogCategoryId);
                    $blogCategoryUrl = $blogCategory->getUrl();
                } catch (\Exception $e) {
                    $blogCategoryUrl = '#';
                }
            }

          
            echo '<div class="footer-blog reveal1"> <div class="post-list-wrapper">';
            echo '<h3 class="title">' . $block->escapeHtml(__('Further Reading')) . '</h3>';
            echo '<ul class="post-list clearfix">';
            $maxLength = 42;
            foreach ($collection as $post) {
                $postTitle = $post->getTitle();
                $shortTitle = strlen($postTitle) > $maxLength ? mb_substr($postTitle, 0, $maxLength) . '...' : $postTitle;
                echo '<li><a href="' . $post->getPostUrl() . '" >' . $block->escapeHtml($shortTitle) . '</a></li>';
            }
            echo '</ul>';

            // View More Button
           echo '<div class="view_more_similar_blog">';
            echo '<a href="' . $block->getUrl('blog') . '" target="_blank">VIEW MORE SIMILAR BLOG</a>';
            echo '</div>';

            echo '</div></div>'; // close .footer-blog
        }
    }
}
?>





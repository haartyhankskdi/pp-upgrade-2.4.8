  <script>
  (function(){
    function ready(fn){document.readyState!=='loading'?fn():document.addEventListener('DOMContentLoaded',fn)}
    ready(function(){
      var select = document.getElementById('strengthSelect');
      var cards  = document.getElementById('cards');
      var dataEl = document.getElementById('optionsData');

      var OPTIONS = {};
      try { OPTIONS = JSON.parse((dataEl.textContent||'{}').trim()); } catch(e){ console.error(e); }

      function money(n){ return '£' + Number(n).toFixed(2); }

      function render(strength){
        var items = OPTIONS[strength] || [];
        cards.innerHTML = items.map(function(o){
          return '<div class="card"> <div class="card-title">'
              +   '<div class="title">'+ o.label +'</div>'
              
              +   '<div class="price">'+ money(o.sku) +'</div>'
               
              
              
              + '</div> </div>';
        }).join('');

        // keep URL in sync (no reload)

        /**
          try{
          var url=new URL(location.href);
          url.searchParams.set('strength', strength);
          history.replaceState({},'',url);
        }catch(_){}
        */
      }

      // Initial sync and on-change behavior
      render(select.value);
      select.addEventListener('change', function(e){ render(e.target.value); });
    });
  })();
  </script>

/** 
 * Get product price by SKU using Magento's ProductRepositoryInterface (factory class)
 * Usage: $price = getProductPriceBySku('WL-WEG-0.25-1');
 */
function getProductPriceBySku($sku) {
    try {
        // $objectManager is available globally in .phtml files
        $productRepository = \Magento\Framework\App\ObjectManager::getInstance()->get('\Magento\Catalog\Api\ProductRepositoryInterface');
        $product = $productRepository->get($sku);
        return $product->getFinalPrice();
    } catch (\Exception $e) {
        // Log the error if needed
        return null;
    }
}



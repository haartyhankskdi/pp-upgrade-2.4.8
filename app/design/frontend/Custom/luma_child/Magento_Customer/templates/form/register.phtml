<script>
    require([
	'jquery',
	'mage/validation'
], function($) {




	$('#fetchify_address').on('input', function(e) {
        $('#fetchify_address_select').val('')
        $('#fetchify_address_message').show();
		spinnerLoader = $(".spinner-loader");
		spinnerLoader.show();
		let postCodeValue = $('#zip').val();
		if (postCodeValue == '') {
		    spinnerLoader.hide();
            $('#zip-error').hide();
		}

		console.log('loadPostcode');
		let Url = "<?php echo $block->getUrl("fetchify/get/address?postcode=");?>";
		$.ajax({
			url: Url + encodeURIComponent(postCodeValue),
            data: {
                'query': $('#fetchify_address').val()
            },
			type: 'GET',
			success: function(response) {
				spinnerLoader = $(".spinner-loader");
				spinnerLoader.hide();
				console.log(response);
				if (response.status == 200) {
                    $('#fetchify_address_select').empty(); // clear any existing
                    $('#fetchify_address_select').show(); // make sure it's visible
                    console.log('if block executed :200 ')
                    console.log(response.response.results);
                    if (response.response.results.length > 0) {
                    // Remove existing options except default if needed
                    $('#fetchify_address').find('option:not(:first)').remove();
                    var i = 0
                    // Create and append options from results.labels
                    response.response.results.forEach(function(item) {
                        
                        let label = item.labels.join(', ');
                        console.log( label);
                        var option = $('<option>', {
                            value: label,
                            text: label
                        });
                        
                        $('#fetchify_address_select').append(option);
                                            
                    });

                    // Select the first option by default if there is at least one
                    $('#fetchify_address_select').prop('selectedIndex', 0).trigger('change');

                    // Show the select if it's hidden
                    $('#fetchify_address').show();
                    } else {
                    var noAddressDiv = $('<div>', {
                        'class': 'mage-error fetchify-no-address-found',
                        'text': 'No address found'
                    });
                    // Remove previous messages if exist
                    $('.fetchify-no-address-found').remove();
                    // Insert the message after the input field (you may adjust selector if needed)
                    $('#fetchify_address').after(noAddressDiv);
                    }
                } else {
                    console.log('else block executed :200 ')
                }

					
				
			},
			error: function(jqXHR, textStatus, errorThrown) {
				console.log("AJAX request failed:", textStatus, errorThrown);
				// Optionally, show a user notification
				var errorDiv = $('<div>', {
					'class': 'mage-error',
					'id': 'postcode-ajax-error',
					'text': 'Sorry, we were unable to look up your address. Please try again later.'
				});
				// Remove previous error if exists
				$('#postcode-ajax-error').remove();
				// Insert after postcode field (or another appropriate place)
				$('#zip').after(errorDiv);
				// Optionally reset fields as appropriate
				$('#postcodes').hide().empty();
			}
		});
	});

	$('#fetchify_address_select').on('change', function() {
		var selectedAddress = $(this).val();
		fillAddressFieldsFromString(selectedAddress);
	});

	$('#postcodes').change(function() {

		console.log('postcodes changed');
		var postcode = $(this).val();
		var line1 = $(this).find('option:selected').data('line_1');
		var line2 = $(this).find('option:selected').data('line_2');
		$('#street_1').val(postcode);
		$('#street_2').val(line2);

		console.log('postcode: ' + postcode);
	});

    $('#manual_address').click(function(){
        $('.fieldset.address').show();
        $('.fieldset.fetchify').hide();
        $('#back_to_address_search').show();

        
    })

    $('#back_to_address_search').click(function(){
        $('.fieldset.address').hide();
        $('.fieldset.fetchify').show();
        $('#back_to_address_search').hide();
    })


	function showRegionIdAndHideRegionInput() {
	    // Hide the region input text
	    $('#region').hide();

	    // Show the region_id select
	    $('#region_id').show();

	    // Enable region_id in case it is disabled
	    $('#region_id').prop('disabled', false);
	}


	function cleanForm() {
	    // Reset street_1 and street_2
		$('#street_1').val('');
		$('#street_2').val('');
		// Reset county/region (for both select and input)
		$('#region_id').val('').trigger('change');
		$('#region').val('');
		// Reset city
		$('#city').val('');
		// Hide and clear the Available Towns select
		$('#Postcodes').val('')
		$('#Postcodes_Container').hide();
	};

function fillAddressFieldsFromString(str) {
    cleanForm();
    if (!str) {
        return;
    }
    var arr = str.split(",");
    arr = arr.map(function(item) { return $.trim(item); });

    // If array has 5 items, use 2nd and 3rd as street1 and street2
    if (arr.length === 5) {
        if (arr[0]) {
            $('#zip').val(arr[0]);
        }
        if (arr[1]) {
            $('#street_1').val(arr[1]);
        }
        if (arr[2]) {
            $('#street_2').val(arr[2]);
        }
        if (arr[3]) {
            $('#city').val(arr[3]);
        }
        if (arr[4]) {
            $('#region_id').hide();
            $('#region_id').prop('disabled', true);
            $('#region').val(arr[4]);
            $('#region').show();
        }
    } else {
        // Fallback for old logic: postcode, street1, city, region
        if (arr[0]) {
            $('#zip').val(arr[0]);
        }
        if (arr[1]) {
            $('#street_1').val(arr[1]);
        }
        if (arr[2]) {
            $('#city').val(arr[2]);
        }
        if (arr[3]) {
            $('#region_id').hide();
            $('#region_id').prop('disabled', true);
            $('#region').val(arr[3]);
            $('#region').show();
        }
    }
}
    // If you wish to select in region_id dropdown (when present)
    // $('#region_id option').filter(function() {
    //     return $(this).text().toLowerCase() === arr[3].toLowerCase();
    // }).prop('selected', true).trigger('change');
});
</script>




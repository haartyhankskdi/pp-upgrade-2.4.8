    var ignore = <?= /* @noEscape */ $_dob->isEnabled() ? '\'input[id$="full"]\'' : 'null' ?>;

    dataForm.mage('validation', {
    <?php if ($_dob->isEnabled()) : ?>
        errorPlacement: function(error, element) {
            if (element.prop('id').search('full') !== -1) {
                var dobElement = $(element).parents('.customer-dob'),
                    errorClass = error.prop('class');
                error.insertAfter(element.parent());
                dobElement.find('.validate-custom').addClass(errorClass)
                    .after('<div class="' + errorClass + '"></div>');
            }
            else {
                error.insertAfter(element);
            }
        },
        ignore: ':hidden:not(' + ignore + ')'
    <?php else : ?>
        ignore: ignore ? ':hidden:not(' + ignore + ')' : ':hidden'
    <?php endif ?>
    }).find('input:text').attr('autocomplete', 'off');

    // Open General Question Section
    $("#general_question_btn").click(function (e) {
        e.preventDefault();
        $('.basic-registration-elements').addClass('hide');
        $('.custom-block-customer-register .reg-header').addClass('hide');
        window.scrollTo(0, 0);
        $(".general-question-fixed").addClass("active");
    });

    // Close General Question
    $(".general_question_btn_cancel").click(function (e) {
        e.preventDefault();
        if(dataForm.validation('isValid')){
            $("#general_question").val(1);
        }else{
            var r = confirm("Are you sure you want to leave? \r\nGeneral Questions will not be submitted");
            if (r == true) {
                $('.basic-registration-elements').removeClass('hide');
                $('.custom-block-customer-register .reg-header').removeClass('hide');
                $("#general_question").val(0);
                $(".general-question-fixed").removeClass("active");
                var genQuestionPosition = $('.general-question-regpage-div').offset();
                window.scrollTo(0, genQuestionPosition.top);
            }
        }
    });

    // Submit of Genral Question
    $('#general_question_submit').click( function() {

        if(dataForm.validation('isValid')){
            $("#general_question").val(1);
            $('.basic-registration-elements').removeClass('hide');
            $('.custom-block-customer-register .reg-header').removeClass('hide');
            $(".general-question-fixed").removeClass("active");
            var genQuestionPosition = $('.general-question-regpage-div').offset();
            window.scrollTo(0, genQuestionPosition.top);
        }
    });

    <?php if(!empty($block->escapeHtmlAttr($block->getFormData()->getEmail()))){ ?>
        var returnNe = true;
    <?php }else{ ?>
        var returnNe = false;
    <?php } ?>

    $("#email_address").change(function (e) {
        e.preventDefault();
        var emailVal = $(this).val();
        var emailError = $("#email_address-custom-error");
        /*
            *this is for email availability
        */
        storage.post(
            BASE_URL+'/rest/V1/customers/isEmailAvailable',
            JSON.stringify({
                customerEmail: emailVal
            }),
            false
        ).done(function (isEmailAvailable) {
            console.log(isEmailAvailable);
            if (isEmailAvailable) {
                emailError.hide();
                returnNe = true;
            }else{
                emailError.html("This email address is already in use by other user");
                emailError.show();
                returnNe = false;
            }
        });
    });

    // Removing re-enter password
    $("#form-validate").submit(function (e) {
        /*
        *This is use for prevent revalidation
        */
        var pass = $("#password").val();
        $("#password_confirmation").val(pass);

        if(returnNe == false){
            e.preventDefault();
        }
    });

    // Add hide show password
    $("#showpassword").click(function (e) {
        e.preventDefault();
        var x = document.getElementById("password");
        if (x.type === "password") {
            x.type = "text";
            $(this).html(`<i class="fa fa-eye-slash" aria-hidden="true"></i>`);
        } else {
            x.type = "password";
            $(this).html(`<i class="fa fa-eye" aria-hidden="true"></i>`);
        }
    });

    // this is for DOB
    $('.dob-day').keyup(function(){
        if($(this).val().length >= 2){
            $(".dob-month").focus();
        }
    });

    $('.dob-month').keyup(function(){
        if($(this).val().length >= 2){
            $(".dob-year").focus();
        }
    });
});
</script>


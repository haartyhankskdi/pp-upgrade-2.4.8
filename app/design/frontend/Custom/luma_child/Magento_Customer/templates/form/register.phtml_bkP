<!-- start validation for Name with hyphens and apostrophes -->
<script type="text/javascript">
    require([
    'jquery',
    'mage/validation'
], function ($) {
    $.validator.addMethod(
        'validate-pattern',
        function (value, element) {
            return this.optional(element) || /^[A-Za-z\'\-]+$/.test(value);
        },
        $.mage.__('Please use only letters, hyphens and apostrophes.')
    );
});

</script>
<!-- start validation for Name with hyphens and apostrophes -->
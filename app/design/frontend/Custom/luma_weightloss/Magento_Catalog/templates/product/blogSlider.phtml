<script>
    document.addEventListener('DOMContentLoaded', function() {
        const carousel = document.querySelector('.post-list');
        const prevButton = document.querySelector('.post-prev');
        const nextButton = document.querySelector('.post-next');
        const intervalTime = 3000; // Time in milliseconds
        let slidesToShow = 4;
        let currentIndex = 0;

        const totalItems = carousel.querySelectorAll('.post-holder').length;

        function updateSlidesToShow() {
            if (window.innerWidth <= 768) {
                slidesToShow = 1;
            } else {
                slidesToShow = 3;
            }
        }

        // Initial update for slidesToShow
        updateSlidesToShow();

        // Listen for window resize to update slidesToShow
        window.addEventListener('resize', () => {
            updateSlidesToShow();
            updateCarousel();
        });

        prevButton.addEventListener('click', () => {
            if (currentIndex > 0) {
                currentIndex--;
                updateCarousel();
            }
        });

        nextButton.addEventListener('click', () => {
            if (currentIndex < totalItems - slidesToShow) {
                currentIndex++;
                updateCarousel();
            }
        });

        function updateCarousel() {
            const itemWidth = carousel.querySelector('.post-holder').offsetWidth;
            const offset = -1 * currentIndex * itemWidth;
            carousel.style.transform = `translateX(${offset}px)`;
        }

        // Auto-slide functionality
        function autoSlide() {
            if (currentIndex < totalItems - slidesToShow) {
                currentIndex++;
            } else {
                currentIndex = 0;
            }
            updateCarousel();
        }

        // Set interval for auto-slide
        // setInterval(autoSlide, intervalTime);
    });
</script>

<script>
    document.addEventListener('DOMContentLoaded', function () {
    var carousel = document.querySelector('.post-list');
    var startX, startY, endX, endY;

    carousel.addEventListener('touchstart', function (event) {
        startX = event.touches[0].clientX;
        startY = event.touches[0].clientY;
    }, false);

    carousel.addEventListener('touchmove', function (event) {
        endX = event.touches[0].clientX;
        endY = event.touches[0].clientY;
    }, false);

    carousel.addEventListener('touchend', function () {
        var diffX = startX - endX;
        var diffY = startY - endY;

        if (Math.abs(diffX) > Math.abs(diffY)) {
            // Swipe left or right
            if (diffX > 0) {
                // Swipe left
                document.querySelector('.post-next').click();
            } else {
                // Swipe right
                document.querySelector('.post-prev').click();
            }
        }
    }, false);
});

</script>


<?php
/**
 * Product view template
 *
 * @var $block \Magento\Catalog\Block\Product\View
 */
$product = $block->getProduct();
if ($product !== null) {
    // Get product description
    $productDescription = $product->getDescription();

    // Get product price
    $productPrice = $product->getPriceInfo()->getPrice('final_price')->getAmount()->getValue();

    // Format the price
    $productPriceFormatted = $block->getProductPriceHtml($product);

    // Output product description and price
    ?>
    <div class="product-description">
        <?php echo $productDescription; ?>
    </div>

    <div class="product-price">
        <?php echo $productPriceFormatted; ?>
    </div>

    <!-- Add to Cart button -->
    <div class="add-to-cart">
        <?php echo $block->getChildHtml('product.info.addtocart'); ?>
    </div>
    <?php
}
?>



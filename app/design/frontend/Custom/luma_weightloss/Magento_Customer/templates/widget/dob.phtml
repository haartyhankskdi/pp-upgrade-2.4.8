<?php
    $helperDob = $this->helper(\Nilesh\Theme\Helper\Dob::class);
    $getDate = $block->getValue();

    $y = $helperDob->getYear($getDate);
    $d = $helperDob->getDay($getDate);
    $m = $helperDob->getMonth($getDate);

    $formatedDate = $helperDob->getFormatedDob($getDate);

    $currentYear = date("Y");
?>

<div class="date-in-dmy <?= $block->escapeHtmlAttr($fieldCssClass) ?>">
    <label class="label" for="<?= /* @noEscape */ $block->getHtmlId() ?>"><span><?= $block->escapeHtml($block->getStoreLabel('dob')) ?></span></label>
    <div class="date-dob-group">
        <div class="control">
            <input type="text" placeholder="DD" maxlength="2" value="<?php echo /* @noEscape */ @$d ?>" class="input-form only_numeric dob-date dob-day" id="dob_d">
        </div>
        <div class="control">
            <input type="text" placeholder="MM" maxlength="2" value="<?php echo /* @noEscape */ @$m ?>" class="input-form only_numeric dob-date dob-month" id="dob_m">
        </div>
        <div class="control">
            <input type="text" placeholder="YYYY" maxlength="4" value="<?php echo /* @noEscape */ @$y ?>" class="input-form only_numeric dob-date dob-year" id="dob_y">

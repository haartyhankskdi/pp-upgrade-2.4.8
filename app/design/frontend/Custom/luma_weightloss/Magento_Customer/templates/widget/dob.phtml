<script type="text/x-magento-init">
    {
       "*": {
           "Magento_Customer/js/validation": {}
       }
    }
 </script>

 <script>
    require(['jquery','jquery/ui', 'jquery/validate', 'mage/translate'], function($){
        $(document).ready(function () {

            // Custom DOB Validation
            $.validator.addMethod('validate-dob-today', function (value, element) {
                    var today = new Date();
                    var dateEntered = new Date();
                    dateEntered.setFullYear($('#dob_y').val(), $('#dob_m').val() - 1, $('#dob_d').val());
                    // alert(dateEntered + ' - ' + today);
                    return dateEntered < today;
            }, $.mage.__('The Date of Birth should not be greater than today.'));
            
            $.validator.addMethod('validate-dob-past', function (value, element) {
                    var past = new Date();
                    past.setFullYear(1900, (1 - 1), 1);
                    var dateEntered = new Date();
                    dateEntered.setFullYear($('#dob_y').val(), $('#dob_m').val() - 1, $('#dob_d').val());
                    // alert(dateEntered + ' - ' + past);
                    return dateEntered > past;
            }, $.mage.__('Please enter a date after the year, 1900'));

            $("#dob").change(function () {
                var  dob_m = $("#dob_m").val();
                var  dob_d = $("#dob_d").val();
                var  dob_y = $("#dob_y").val();
                if(dob_m.length != 0 && dob_d.length != 0 && dob_y.length != 0){
                    $("#dob").val(`${dob_d}/${dob_m}/${dob_y}`);
                }else{
                    $("#dob").val("");
                }
            });

            $("#dob_d").change(function (e) {
                var selfval = $(this).val();
                if(selfval > 31){
                    selfval = 31;
                }
                var  dob_m = $("#dob_m").val();
                var  dob_d = padMe(selfval);
                var  dob_y = $("#dob_y").val();
                $(this).val(dob_d);
                if(dob_m.length != 0 && dob_d.length != 0 && dob_y.length != 0){
                    $("#dob").val(`${dob_d}/${dob_m}/${dob_y}`);
                }else{
                    $("#dob").val("");
                }
            });

            $("#dob_m").change(function (e) {
                var selfval = $(this).val();
                if(selfval > 12){
                    selfval = 12;
                }
                var  dob_m = padMe(selfval);
                var  dob_d = $("#dob_d").val();
                var  dob_y = $("#dob_y").val();
                $(this).val(dob_m);
                if(dob_m.length != 0 && dob_d.length != 0 && dob_y.length != 0){
                    $("#dob").val(`${dob_d}/${dob_m}/${dob_y}`);
                }else{
                    $("#dob").val("");
                }
            });

            $("#dob_y").change(function (e) {
                var  dob_m = $("#dob_m").val();
                var  dob_d = $("#dob_d").val();
                var  dob_y = $(this).val();
                $(this).val(dob_y);
                if(dob_m.length != 0 && dob_d.length != 0 && dob_y.length != 0){
                    $("#dob").val(`${dob_d}/${dob_m}/${dob_y}`);
                }else{
                    $("#dob").val("");
                }
            });

            function padMe(d) {
                return (d < 10 && d.length == 1) ? '0' + d.toString() : d.toString();
            }

            $(".only_numeric").on('propertychange input', function(e) {
                var contact_num = jQuery(this).val();
                $(this).val(contact_num.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1'));
            });

        });
    });
 </script>

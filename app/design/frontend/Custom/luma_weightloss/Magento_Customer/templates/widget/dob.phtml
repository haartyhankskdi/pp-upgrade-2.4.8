    </div>
</div>

<div class="dob-absolute-underground">
    <div class="make-it-invisible">
        <div class="control customer-dob">
            <?php // echo $block->getFieldHtml() ?>
            <input type="text" name="dob" id="dob" value="<?php echo $formatedDate;  ?>" class="_has-datepicker" data-validate="{required:true,'validate-date':{'dateFormat':'dd\/MM\/yyyy'}, 'validate-dob-today':true, 'validate-dob-past':true}" autocomplete="off">

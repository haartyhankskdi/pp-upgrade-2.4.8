  /*---------------------meet the team----------------*/

  .meet-the-team {
    padding-bottom: 100px;
    border-bottom: 1px solid #dcdcdc;
    margin-bottom: 12px;
  }

  .meet-the-team .row>.column {
    padding: 0 0px;
    margin-right: 55px;
  }

  .meet-the-team .row:after {
    content: "";
    display: table;
    clear: both;
  }

  .meet-the-team .column {
    float: left;
    width: 27%;
  }

  /* The Modal (background) */
  .meet-the-team .modal {
    display: none;
    position: fixed;
    z-index: 9999;
    padding-top: 70px;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    overflow: auto;
    background-color: #fff;
    text-align: center;
  }

  /* Modal Content */
  .meet-the-team .modal-content {
    position: relative;
    background-color: #F1F7F9;
    margin: auto;
    padding: 60px 30px 60px 60px;
    width: 1030px;
    max-width: 100%;
    float: none;
    display: inline-block;
    height: 375px;
  }

  /* The Close Button */
  .meet-the-team .close {
    color: #2C596D;
    position: absolute;
    top: 10px;
    right: 25px;
    font-size: 36px;
    font-weight: 300;
  }

  .meet-the-team .close:hover,
  .meet-the-team .close:focus {
    color: #999;
    text-decoration: none;
    cursor: pointer;
  }

  .meet-the-team .mySlides {
    display: none;
  }

  .meet-the-team .cursor {
    cursor: pointer;
  }


  .meet-the-team .column .bio-img:hover,
  .meet-the-team .column h3:hover {
    cursor: pointer;
  }

  /* Next & previous buttons */
  .meet-the-team .prev,
  .meet-the-team .next {
    cursor: pointer;
    position: absolute;
    top: 50%;
    width: auto;
    padding: 16px;
    margin-top: -50px;
    color: #2C596D;
    font-weight: 300;
    font-size: 26px;
    transition: 0.6s ease;
    border-radius: 0 3px 3px 0;
    user-select: none;
    -webkit-user-select: none;

  }

  .meet-the-team .prev {
    left: -60px;
  }

  .meet-the-team .next {
    right: -60px;
  }

  /* Position the "next button" to the right */
  .meet-the-team .next {

    border-radius: 3px 0 0 3px;
  }

  /* On hover, add a black background color with a little bit see-through */
  .meet-the-team .prev:hover,
  .meet-the-team .next:hover {
    background-color: rgba(0, 0, 0, 0);
    text-decoration: none;
  }

  /* Number text (1/3 etc) */

    .view-treatment-content #menu li a {
      padding: 0px 0px;
      font-size: 14px;
      font-family: 'Ubuntu', sans-serif;
      font-weight: 400;
      color: #000;

    }


    .view-treatment-content #menuToggle input:checked~div {
      transform: none;
      min-height: 100vh;
      height: auto;
      text-align: left;
      padding-left: 15px;
      background: #C8ECF8;
    }

    .view-treatment-content ul.menu-1 li {
      width: 90%;
      float: left;
    }

    .view-treatment-content ul.menu-1 li ul li a {
      padding: 5px 0 !important;
    }

    .view-treatment-content ul.menu-1 li ul li {
      padding: 0px 0 !important;
      border-bottom: 0 !important;
    }

    .view-treatment-content ul.menu-1 {
      width: 100%;
      margin: 20px 0;
      padding: 0 0px;
      background: transparent;
      color: #eee;
      box-shadow: 0 0px rgba(0, 0, 0, .0) inset;
      height: 570px;
      overflow-y: scroll;
      float: left;
    }

    .view-treatment-content ul.menu-1::-webkit-scrollbar {
      width: 8px;
    }

    .view-treatment-content ul.menu-1::-webkit-scrollbar-track {
      background-color: rgba(130, 186, 194, 0.1);
      border-radius: 0px;
    }

    .view-treatment-content ul.menu-1::-webkit-scrollbar-thumb {
      border-radius: 0px;
      background-color: rgba(44, 89, 109, 0.1);
    }


    .view-treatment-content ul.menu-1>li {
      float: left;
      list-style-type: none;
      position: relative;
    }

    .view-treatment-content label {
      position: relative;
      display: block;
      padding: 0 18px 0 0px;
      line-height: 1em;
      transition: background 0.3s;
      cursor: pointer;
      color: #fff;
      text-align: left;
      width: 100%;
      float: left;
    }

    .view-treatment-content label:after {
      content: "";
      position: absolute;
      display: block;
      top: 42%;
      right: 0px;
      width: 0;
      height: 0;
      border-top: 5px solid rgba(0, 0, 0, 1);
      border-bottom: 0 solid rgba(255, 255, 255, 1);
      border-left: 5px solid transparent;
      border-right: 5px solid transparent;
      transition: border-bottom .1s, border-top .1s .1s;
    }

    .view-treatment-content label:hover,
    .view-treatment-content input:checked~label {
      background: rgba(0, 0, 0, .0);
      padding-bottom: 0px;
    }

    .view-treatment-content input:checked~label:after {
      border-top: 0 solid rgba(255, 255, 255, 1);
      border-bottom: 5px solid rgba(255, 255, 255, 1);
      transition: border-top .1s, border-bottom .1s .1s;
    }

    /*hide the inputs*/
    .view-treatment-content input {
      display: none
    }

    /*show the second levele menu of the selected voice*/
    .view-treatment-content input:checked~ul.submenu {
      max-height: 300px;
      transition: max-height 0.5s ease-in;
      z-index: 999;
      min-width: 100%;
      width: 100%;

    }

    /*style for the second level menu*/
    .view-treatment-content ul.submenu {
      max-height: 0;
      padding: 0;
      overflow: visible;
      list-style-type: none;
      background: #000;
      box-shadow: 0 0 1px rgba(0, 0, 0, .3);
      transition: max-height 0.5s ease-out;
      position: relative;
      min-width: 100%;
      z-index: 999;
    }

    .view-treatment-content ul.submenu li a {
      display: block;
      padding: 12px;
      color: #ddd;
      text-decoration: none;
      box-shadow: 0 0px rgba(0, 0, 0, .5) inset;
      transition: background .3s;
      white-space: nowrap;
    }

    .view-treatment-content ul.submenu li a:hover {
      background: rgba(0, 0, 0, .3);
    }

  }



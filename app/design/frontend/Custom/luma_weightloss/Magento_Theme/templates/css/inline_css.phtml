    .view-treatment-content #menuToggle span {
      display: block;
      width: 20px;
      height: 1px;
      margin-bottom: 5px;
      position: relative;

      background: #2C596D;
      border-radius: 0px;

      z-index: 1;

      transform-origin: 0px 0px;

      transition: transform 0.5s cubic-bezier(0.77, 0.2, 0.05, 1.0),
        background 0.5s cubic-bezier(0.77, 0.2, 0.05, 1.0),
        opacity 0.55s ease;
    }

    .view-treatment-content #menuToggle span:first-child {
      transform-origin: 0% 0%;
    }

    .view-treatment-content #menuToggle span:nth-last-child(2) {
      transform-origin: 0% 100%;
    }

    .view-treatment-content #menuToggle input:checked~span {
      opacity: 1;
      transform: rotate(45deg) translate(-2px, -2px);
      background: #000;
    }

    .view-treatment-content #menuToggle input:checked~span:nth-last-child(3) {
      opacity: 0;
      transform: rotate(0deg) scale(0.2, 0.2);
    }


    .view-treatment-content #menuToggle input:checked~span:nth-last-child(2) {
      transform: rotate(-45deg) translate(0, -1px);
    }



      font-size: 18px;
      font-weight: 400;
      padding: 0 0 10px 0;
      margin: 0 0 10px 0;
      text-decoration: none;
      line-height: 38px;
    }

    .accordion-tab label::after {
      /*content: "\25b6";*/
      content: " ";
      position: absolute;
      right: 0px;
      top: 15px;
      display: block;
      transition: all 0.4s;
      display: block;
      color: #fff;
      font-size: 12px;
      background: url(<?php echo $this->getViewFileUrl('images/footer-arrow.png'); ?>) no-repeat;
      width: 8px;
      height: 14px;
    }


/* Common styling */

.hide {
	display: none;
}

/* Login page styling */

.block-customer-login.custom-block-customer-login {
    margin: 60px auto 0;
    float: none !important;
    width: 40%;
}

.custom-block-customer-login .block-title {
    text-align: center;
    color: #2C596D;
	font-family: 'Ubuntu', sans-serif;
	border-bottom: none !important;
	margin-bottom: 0 !important;
}

.small-header {
	font-family: 'Ubuntu', sans-serif;
    border-bottom: none;
    border-left: none;
    border-right: none;
    text-align: center;
	border-color: rgba(225, 225, 225, 0.6);
	border-width: 1px;
	font-size: 15px;
	color: #101010;
	font-weight: 300;
	margin-top: 10px;
}

.small-header legend {
	padding-inline-start: 8px;
	padding-inline-end: 8px;
}

.custom-block-customer-login .block-title #block-customer-login-heading {
    font-size: 34px;
}

.block-customer-login.custom-block-customer-login .fieldset > .field > .control {
	width: 100%;
}

.custom-form {
	border-bottom: 1px solid #c6c6c6;
}

.custom-form input, .custom-form select {
    background-color: #f1f7f9 !important;
    border-radius: 40px !important;
    padding: 23px 32px !important;
    height: auto !important;
    border-color: #d7e7ec !important;
}

.custom-form input::placeholder {
    color: #161616;
}

.custom-form button.action.primary {
    background-color: #ED3237;
    font-size: 16px;
    color: #fff;
    font-family: 'Ubuntu', sans-serif;
    line-height: 37px;
    border: 0;
    padding: 10px 40px;
    font-weight: 400;
    box-shadow: inset 0 0px 0 0 #ffffff, inset 0 0 0 0 rgba(204, 204, 204, 0);
    border-radius: 50px;
}

.custom-login-actions-toolbar {
    display: flex;
}

.custom-login-actions-toolbar .secondary {
    align-self: center;
    margin-left: auto;
}

.register-text {
    font-family: 'Ubuntu', sans-serif;
    font-size: 19px;
    font-weight: normal;
    text-align: center;
	color: #101010;
	margin-top: 40px;
}

.register-text a {
	text-decoration: underline;
	color: #101010;
}

.register-text a:hover {
    color: #2C596D;
}

.forgot-password-link {
    color: #2C596D;
    text-decoration: underline;
    font-size: 14px;
}

.forgot-password-link:hover {
    color: #101010;
}


/* Register page additional styling */

.custom-block-customer-register {
	margin: 0 auto;
}

.custom-block-customer-register .form-create-account.custom-form {
	width: 100%;
}

.small-header legend.legend {
	padding-bottom: 0;
	border: none;
}

.general-question-fixed {
	display: none;
}

.general-question-fixed.active {
	display: block;
}



@media only screen and (max-width: 767px) {
	.block-customer-login.custom-block-customer-login {
		width: 100%;
	}
	
	.custom-block-customer-register {
		width: 100%;
	}
}

@media only screen and (min-width: 768px) and (max-width: 1024px) {
	.block-customer-login.custom-block-customer-login {
		width: 80%;
	}

	.custom-block-customer-register {
		width: 80%;
	}
}

@media only screen and (min-width: 1025px) {
	.block-customer-login.custom-block-customer-login {
		width: 40%;
	}

	.custom-block-customer-register {
		width: 60%;
	}
}


/* search box */

.searchbar .block-search {
     width: 100%;
 }

 .searchbar .block-search .control {
    display: flex;
    background-color: #fff;
    padding: 17px;
    border: 1px solid #373737;
    border-radius: 34px;
 }

 .searchbar .block-search .control select {
    width: auto;
    border: none;
    border-right: 1px solid #828282;
 }

 .searchbar .block-search .control input {
    border: none;
    box-shadow: none;
    padding-left: 18px;
    font-family: 'Ubuntu', sans-serif;
    font-size: 14px;
    font-weight: 400;
 }

 .searchbar .block-search .control input:focus, .searchbar .block-search .control select:focus {
    border: none;
    box-shadow: none;
 }
 
.searchbar .block-search .actions .action.search {
	 top: 17px;
	 right: 30px;
 }


